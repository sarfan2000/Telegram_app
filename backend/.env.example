# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/reward-quiz?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string_at_least_64_chars
JWT_EXPIRES_IN=30d

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# ── Rewards ──────────────────────────────────────────────────────────────────
DAILY_REWARD_POINTS=50
AD_REWARD_POINTS=10
QUIZ_POINTS_PER_CORRECT=10
MAX_DAILY_AD_WATCHES=10
